# Copy to .env (never commit .env). In GitHub, add these as Actions secrets instead.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat id (run `radar chat-id` after messaging your bot once)
TELEGRAM_CHAT_ID=

# Optional overrides
# RADAR_DB_PATH=data/radar.db
# RADAR_CONFIG=config/settings.yaml
# LOG_LEVEL=INFO
# RADAR_TIMEZONE=America/New_York   # time zone for times shown in Telegram

# Phase 2 (not used yet): AI provider. Leave empty to run in rule-based mode.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
